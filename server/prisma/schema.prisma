generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Role {
  ADMIN
  BODEGUERO
  VENDEDOR
}

enum ProductStatus {
  ACTIVO
  EN_OFERTA
  INACTIVO
}

enum MovementType {
  INGRESO
  VENTA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  MERMA
  AJUSTE
  ANULACION
  DONACION
}

enum AdjustmentReason {
  DANADO_RECEPCION
  MERMA_FISICA
  VENCIMIENTO
  DONACION
  OTRO
}

enum TransferStatus {
  PENDIENTE
  EN_TRANSITO
  COMPLETADO
  CANCELADO
}

enum DocumentType {
  BOLETA_ELECTRONICA
  FACTURA_ELECTRONICA
  TICKET_INTERNO
}

enum TaxStatus {
  PENDIENTE
  EMITIDO
  RECHAZADO
  ANULADO
}

// ================= MODELOS =================

model User {
  id                  String      @id @default(uuid(7)) @db.Uuid
  rut                 String      @unique
  email               String      @unique
  name                String
  password            String
  role                Role
  isActive            Boolean     @default(true)
  tokenVersion        Int            @default(0)

  assignedWarehouse   Warehouse?  @relation("UserAssignedWarehouse", fields: [assignedWarehouseId], references: [id])
  assignedWarehouseId Int?

  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  movements           Movement[]
  sales               Sale[]
  refreshTokens       RefreshToken[]
  transfersCreated    TransferRequest[] @relation("TransferCreatedBy")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  isRevoked Boolean  @default(false)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime?  @db.Timestamptz(3)
  replacedByToken   String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id            Int @id @default(autoincrement())
  sku           String        @unique
  barcode       String        @unique
  name          String
  brand         String
  supplier      String

  volume        Decimal?      @db.Decimal(10, 4)
  weight        Decimal?      @db.Decimal(10, 3)
  unitOfMeasure String

  basePrice     Decimal       @db.Decimal(12, 2)
  criticalStock Decimal       @default(10) @db.Decimal(12, 3)
  status        ProductStatus @default(ACTIVO)

  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  stocks        Stock[]
  movements     Movement[]
  saleDetails   SaleDetail[]
  transferItems TransferItem[]

  @@index([name])
  @@index([status])
}

model Warehouse {
  id        Int @id @default(autoincrement())
  name      String   @unique
  location  String?
  isActive  Boolean  @default(true)

  assignedUsers     User[]            @relation("UserAssignedWarehouse")
  stocks            Stock[]
  movementsFrom     Movement[]        @relation("WarehouseFrom")
  movementsTo       Movement[]        @relation("WarehouseTo")
  sales             Sale[]            @relation("WarehouseSales")
  transfersOrigin   TransferRequest[] @relation("TransferOrigin")
  transfersDestination TransferRequest[] @relation("TransferDestination")
}

model Stock {
  id          Int @id @default(autoincrement())
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  version     Int       @default(0)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   Int

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId Int

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model TransferRequest {
  id              String         @id @default(uuid(7)) @db.Uuid
  status          TransferStatus @default(PENDIENTE)

  originWarehouse Warehouse      @relation("TransferOrigin", fields: [originId], references: [id])
  originId        Int

  destWarehouse   Warehouse      @relation("TransferDestination", fields: [destId], references: [id])
  destId          Int

  createdBy       User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdById     String @db.Uuid

  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  items           TransferItem[]
  movements       Movement[]

  @@index([status])
}

model TransferItem {
  id         String          @id @default(uuid(7)) @db.Uuid
  quantity   Decimal         @db.Decimal(12, 3)

  transfer   TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String @db.Uuid

  product    Product         @relation(fields: [productId], references: [id])
  productId  Int
}

model Movement {
  id           Int               @id @default(autoincrement())
  type         MovementType
  quantity     Decimal           @db.Decimal(12, 3)

  unitCost     Decimal?          @db.Decimal(12, 2)
  reason       AdjustmentReason?
  comment      String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId       String            @db.Uuid

  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId    Int

  fromWarehouse   Warehouse?     @relation("WarehouseFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  fromWarehouseId Int?

  toWarehouse     Warehouse?     @relation("WarehouseTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   Int?

  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleId          String?        @db.Uuid // <--- Faltaba @db.Uuid (sin esto falla prisma validate)

  saleDetail      SaleDetail?    @relation(fields: [saleDetailId], references: [id], onDelete: Restrict)
  saleDetailId    String?        @db.Uuid

  transfer        TransferRequest? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  transferId      String?          @db.Uuid

  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([productId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([saleId])
  @@index([saleDetailId])
}

model Sale {
  id             String       @id @default(uuid(7)) @db.Uuid
  
  // Desglose tributario para Boleta / Factura Electrónica
  netAmount      Decimal?      @db.Decimal(12, 2) // Neto sin IVA
  taxAmount      Decimal?      @db.Decimal(12, 2) // IVA (19%)
  total          Decimal      @db.Decimal(12, 2) // Total abonado

  // PREPARADO PARA BOLETA ELECTRÓNICA Y FACTURACIÓN
  documentType   DocumentType? @default(TICKET_INTERNO)
  taxStatus      TaxStatus?    @default(PENDIENTE)
  folio          Int?         // Número de boleta fiscal emitido
  customerRut    String?      // RUT del comprador para facturas/boletas nominativas

  seller         User         @relation(fields: [sellerId], references: [id])
  sellerId       String @db.Uuid

  warehouse      Warehouse    @relation("WarehouseSales", fields: [warehouseId], references: [id])
  warehouseId    Int

  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  details        SaleDetail[]
  movements      Movement[]
  idempotencyKey String     
  payloadHash    String

  @@unique([sellerId, idempotencyKey])
  @@index([createdAt])
  @@index([warehouseId, createdAt(sort: Desc)])
  @@unique([documentType, folio])
}

model SaleDetail {
  id               String     @id @default(uuid(7)) @db.Uuid
  quantity         Decimal    @db.Decimal(12, 3)
  
  // Soporte para devoluciones parciales y emisión de Notas de Crédito por ítem (futuro)
  returnedQuantity Decimal    @default(0) @db.Decimal(12, 3)

  unitPrice        Decimal    @db.Decimal(12, 2)
  subtotal         Decimal    @db.Decimal(12, 2)

  sale             Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleId           String @db.Uuid

  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId        Int

  movements        Movement[]

  @@index([saleId])
  @@index([productId])
}