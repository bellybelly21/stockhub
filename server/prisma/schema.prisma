generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Role {
  ADMIN
  BODEGUERO
  VENDEDOR
}

enum ProductStatus {
  ACTIVO
  EN_OFERTA
  INACTIVO
}

enum MovementType {
  INGRESO
  VENTA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  MERMA
  AJUSTE
  ANULACION
  DONACION
}

enum AdjustmentReason {
  DANADO_RECEPCION
  MERMA_FISICA
  VENCIMIENTO
  DONACION
  OTRO
}

enum TransferStatus {
  PENDIENTE
  EN_TRANSITO
  COMPLETADO
  CANCELADO
}

enum DocumentType {
  BOLETA_ELECTRONICA
  FACTURA_ELECTRONICA
  TICKET_INTERNO
}

enum TaxStatus {
  PENDIENTE
  EMITIDO
  RECHAZADO
  ANULADO
}

// ================= MODELOS =================

model User {
  id                  String      @id @default(uuid(7))
  rut                 String      @unique
  email               String      @unique
  name                String
  password            String
  role                Role
  isActive            Boolean     @default(true)

  assignedWarehouse   Warehouse?  @relation("UserAssignedWarehouse", fields: [assignedWarehouseId], references: [id])
  assignedWarehouseId String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  movements           Movement[]
  sales               Sale[]
  refreshTokens       RefreshToken[]
  transfersCreated    TransferRequest[] @relation("TransferCreatedBy")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id            String        @id @default(uuid(7))
  sku           String        @unique
  barcode       String        @unique
  name          String
  brand         String
  supplier      String

  volume        Decimal?      @db.Decimal(10, 4)
  weight        Decimal?      @db.Decimal(10, 3)
  unitOfMeasure String

  basePrice     Decimal       @db.Decimal(12, 2)
  criticalStock Decimal       @default(10) @db.Decimal(12, 3)
  status        ProductStatus @default(ACTIVO)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stocks        Stock[]
  movements     Movement[]
  saleDetails   SaleDetail[]
  transferItems TransferItem[]

  @@index([barcode])
  @@index([status])
  @@index([id(sort: Desc)])
}

model Warehouse {
  id        String   @id @default(uuid(7))
  name      String
  location  String?
  isActive  Boolean  @default(true)

  assignedUsers     User[]            @relation("UserAssignedWarehouse")
  stocks            Stock[]
  movementsFrom     Movement[]        @relation("WarehouseFrom")
  movementsTo       Movement[]        @relation("WarehouseTo")
  sales             Sale[]            @relation("WarehouseSales")
  transfersOrigin   TransferRequest[] @relation("TransferOrigin")
  transfersDestination TransferRequest[] @relation("TransferDestination")
}

model Stock {
  id          String    @id @default(uuid(7))
  quantity    Decimal   @default(0) @db.Decimal(12, 3)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   String

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId String

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model TransferRequest {
  id              String         @id @default(uuid(7))
  status          TransferStatus @default(PENDIENTE)

  originWarehouse Warehouse      @relation("TransferOrigin", fields: [originId], references: [id])
  originId        String

  destWarehouse   Warehouse      @relation("TransferDestination", fields: [destId], references: [id])
  destId          String

  createdBy       User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdById     String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           TransferItem[]
  movements       Movement[]

  @@index([status])
}

model TransferItem {
  id         String          @id @default(uuid(7))
  quantity   Decimal         @db.Decimal(12, 3)

  transfer   TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String

  product    Product         @relation(fields: [productId], references: [id])
  productId  String
}

model Movement {
  id           String            @id @default(uuid(7))
  type         MovementType
  quantity     Decimal           @db.Decimal(12, 3)
  
  // Registra costo de compra en INGRESO para calcular FIFO / Promedio Ponderado
  unitCost     Decimal?          @db.Decimal(12, 2)
  
  reason       AdjustmentReason?
  comment      String?

  user         User              @relation(fields: [userId], references: [id])
  userId       String

  product      Product           @relation(fields: [productId], references: [id])
  productId    String

  fromWarehouse   Warehouse?     @relation("WarehouseFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId String?

  toWarehouse     Warehouse?     @relation("WarehouseTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   String?

  sale            Sale?          @relation(fields: [saleId], references: [id])
  saleId          String?

  // Devolución o anulación ligada directamente al ítem exacto del detalle
  saleDetail      SaleDetail?    @relation(fields: [saleDetailId], references: [id])
  saleDetailId    String?

  transfer        TransferRequest? @relation(fields: [transferId], references: [id])
  transferId      String?

  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model Sale {
  id             String       @id @default(uuid(7))
  
  // Desglose tributario para Boleta / Factura Electrónica
  netAmount      Decimal      @db.Decimal(12, 2) // Neto sin IVA
  taxAmount      Decimal      @db.Decimal(12, 2) // IVA (19%)
  total          Decimal      @db.Decimal(12, 2) // Total abonado

  // PREPARADO PARA BOLETA ELECTRÓNICA Y FACTURACIÓN
  documentType   DocumentType @default(TICKET_INTERNO)
  taxStatus      TaxStatus    @default(PENDIENTE)
  folio          Int?         // Número de boleta fiscal emitido
  customerRut    String?      // RUT del comprador para facturas/boletas nominativas

  seller         User         @relation(fields: [sellerId], references: [id])
  sellerId       String

  warehouse      Warehouse    @relation("WarehouseSales", fields: [warehouseId], references: [id])
  warehouseId    String

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  details        SaleDetail[]
  movements      Movement[]
  idempotencyKey String?      @unique

  @@index([createdAt])
  @@index([sellerId])
  @@index([warehouseId])
  @@index([folio])
}

model SaleDetail {
  id               String     @id @default(uuid(7))
  quantity         Decimal    @db.Decimal(12, 3)
  
  // Soporte para devoluciones parciales y emisión de Notas de Crédito por ítem (futuro)
  returnedQuantity Decimal    @default(0) @db.Decimal(12, 3)

  unitPrice        Decimal    @db.Decimal(12, 2)
  subtotal         Decimal    @db.Decimal(12, 2)

  sale             Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId           String

  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId        String

  movements        Movement[]

  @@index([saleId])
}