generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Role {
  ADMIN
  BODEGUERO
  VENDEDOR
}

enum ProductStatus {
  ACTIVO
  EN_OFERTA
  DONADO
  INACTIVO
}

enum MovementType {
  INGRESO
  VENTA
  TRANSFERENCIA
  MERMA
  AJUSTE
  ANULACION
  DONACION
}

enum AdjustmentReason {
  DANADO_RECEPCION
  MERMA_FISICA
  VENCIMIENTO
  DONACION
  OTRO
}

// ================= MODELOS =================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  name                String
  password            String     // Hash bcrypt
  role                Role
  isActive            Boolean    @default(true) // Baja lógica de usuario
  
  assignedWarehouse   Warehouse? @relation("UserAssignedWarehouse", fields: [assignedWarehouseId], references: [id])
  assignedWarehouseId String?
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  movements           Movement[]
  sales               Sale[]
  refreshTokens       RefreshToken[]
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique // Almacenamiento seguro del hash del refresh token
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  createdAt DateTime @default(now())
  @@index([userId])
}

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  barcode       String        @unique
  name          String
  brand         String
  supplier      String
  
  // Opcionales en BD para soportar productos medidos por peso O por volumen
  volume        Decimal?      @db.Decimal(10, 4) // ej: m3 o litros
  weight        Decimal?      @db.Decimal(10, 3) // ej: kg (soporta 100 kg sin problema)
  unitOfMeasure String        // "UNIDAD", "KG", "LITRO", etc.
  
  basePrice     Decimal       @db.Decimal(12, 2)
  criticalStock Decimal       @default(10) @db.Decimal(12, 3)
  status        ProductStatus @default(ACTIVO)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stocks        Stock[]
  movements     Movement[]
  saleDetails   SaleDetail[]

  @@index([barcode])
  @@index([status])
}

model Warehouse {
  id            String     @id @default(uuid())
  name          String
  location      String?
  isActive      Boolean    @default(true)

  assignedUsers User[]     @relation("UserAssignedWarehouse")
  stocks        Stock[]
  movementsFrom Movement[] @relation("WarehouseFrom")
  movementsTo   Movement[] @relation("WarehouseTo")
  sales         Sale[]     @relation("WarehouseSales")
}

model Stock {
  id          String    @id @default(uuid())
  quantity    Decimal   @default(0) @db.Decimal(12, 3) // Soporta fraccionados (ej. KG)
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   String
  
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId String

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model Movement {
  id              String            @id @default(uuid())
  type            MovementType
  quantity        Decimal           @db.Decimal(12, 3)
  reason          AdjustmentReason? 
  comment         String?           
  
  user            User              @relation(fields: [userId], references: [id])
  userId          String

  product         Product           @relation(fields: [productId], references: [id])
  productId       String

  fromWarehouse   Warehouse?        @relation("WarehouseFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId String?

  toWarehouse     Warehouse?        @relation("WarehouseTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   String?

  sale            Sale?             @relation(fields: [saleId], references: [id])
  saleId          String?
  
  createdAt       DateTime          @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model Sale {
  id          String       @id @default(uuid())
  total       Decimal      @db.Decimal(12, 2)
  isActive    Boolean      @default(true) // Anulación
  
  seller      User         @relation(fields: [sellerId], references: [id])
  sellerId    String

  warehouse   Warehouse    @relation("WarehouseSales", fields: [warehouseId], references: [id])
  warehouseId String       

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  details     SaleDetail[]
  movements   Movement[]   

  @@index([createdAt])
  @@index([sellerId])
  @@index([warehouseId])
  idempotencyKey String? @unique
}

model SaleDetail {
  id        String   @id @default(uuid())
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  @@index([saleId])
}