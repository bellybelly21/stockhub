generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Role {
  ADMIN
  BODEGUERO
  VENDEDOR
}

// Estado del producto en el catálogo general
enum ProductStatus {
  ACTIVO
  EN_OFERTA
  INACTIVO
}

enum MovementType {
  INGRESO
  VENTA
  TRANSFERENCIA
  MERMA
  AJUSTE
  ANULACION
  DONACION
}

// Listado cerrado de motivos para justificar mermas y ajustes
enum AdjustmentReason {
  DANADO_RECEPCION
  MERMA_FISICA
  VENCIMIENTO
  DONACION
  OTRO
}

// ================= MODELOS =================

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  password            String   
  role                Role
  isActive            Boolean  @default(true) 
  
  assignedWarehouse   Warehouse? @relation("UserAssignedWarehouse", fields: [assignedWarehouseId], references: [id])
  assignedWarehouseId String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  movements           Movement[]
  sales               Sale[]
  refreshTokens       RefreshToken[] 
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  createdAt DateTime @default(now())
}

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  barcode       String?       @unique 
  name          String
  brand         String
  supplier      String
  
  volume        Decimal?      @db.Decimal(10, 4) 
  weight        Decimal?      @db.Decimal(10, 3) 
  unitOfMeasure String        // ej: "UNIDAD", "KG", "LITRO"
  basePrice     Decimal       @db.Decimal(12, 2)
  criticalStock Decimal       @default(10) @db.Decimal(12, 3) 
  status        ProductStatus @default(ACTIVO) 
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stocks        Stock[]
  movements     Movement[]
  saleDetails   SaleDetail[]
}

model Warehouse {
  id            String   @id @default(uuid())
  name          String
  location      String?
  isActive      Boolean  @default(true)

  assignedUsers User[]   @relation("UserAssignedWarehouse")
  stocks        Stock[]
  movementsFrom Movement[] @relation("WarehouseFrom")
  movementsTo   Movement[] @relation("WarehouseTo")
  sales         Sale[]     @relation("WarehouseSales")
}

model Stock {
  id          String    @id @default(uuid())
  quantity    Decimal   @default(0) @db.Decimal(12, 3) 
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   String
  
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId String

  @@unique([productId, warehouseId]) 
}

model Movement {
  id              String            @id @default(uuid())
  type            MovementType
  quantity        Decimal           @db.Decimal(12, 3)
  reason          AdjustmentReason? 
  comment         String?           
  
  user            User              @relation(fields: [userId], references: [id])
  userId          String

  product         Product           @relation(fields: [productId], references: [id])
  productId       String

  fromWarehouse   Warehouse?        @relation("WarehouseFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId String?

  toWarehouse     Warehouse?        @relation("WarehouseTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   String?

  sale            Sale?             @relation(fields: [saleId], references: [id])
  saleId          String?
  
  createdAt       DateTime          @default(now())
}

model Sale {
  id          String       @id @default(uuid())
  total       Decimal      @db.Decimal(12, 2)
  isActive    Boolean      @default(true) // Permite anulación lógica de la venta
  
  seller      User         @relation(fields: [sellerId], references: [id])
  sellerId    String

  warehouse   Warehouse    @relation("WarehouseSales", fields: [warehouseId], references: [id])
  warehouseId String       

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  details     SaleDetail[]
  movements   Movement[]   
}

model SaleDetail {
  id        String   @id @default(uuid())
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
}